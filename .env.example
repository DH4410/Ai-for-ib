# Put real values only in .env.local or your deployment secret manager.
# This application talks to its own model endpoint; OpenAI-compatible is a
# protocol, not a requirement to use the ChatGPT product.
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_NAME=Dima-IB-Tutor-v1
MODEL_API_KEY=

# Embeddings are generated by a separately configurable self-hosted endpoint.
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

# Server-only credentials. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INGESTION_ADMIN_SECRET=
